{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pre-SDD to SDD-Unifier handoff blueprint",
  "description": "Proposed calculator-owned companion input. It is NOT a native schema of the existing SDD-Unifier skill. BRD owns product UCs and roles.",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "sources",
    "requirements",
    "calculations",
    "architecture",
    "dr_scenarios",
    "decisions",
    "diagrams",
    "conflicts",
    "governance",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "change_type",
        "target_hosting"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "change_type": {
          "enum": [
            "GF",
            "BF",
            "mixed",
            "undecided"
          ]
        },
        "target_hosting": {
          "enum": [
            "CL",
            "OP",
            "hybrid",
            "undecided"
          ]
        },
        "source_to_target": {
          "type": "string"
        },
        "project_status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "required": [
        "pre_sdd",
        "brds",
        "sdd_skill"
      ],
      "properties": {
        "pre_sdd": {
          "type": "object",
          "required": [
            "path",
            "version",
            "approval_status"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "approval_status": {
              "enum": [
                "draft",
                "discovery",
                "under_review",
                "approved",
                "approved_with_conditions",
                "blocked"
              ]
            },
            "source_sha256": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "brds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "path",
              "version"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Z0-9_]+$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "sdd_skill": {
          "type": "object",
          "required": [
            "name",
            "sha256"
          ],
          "properties": {
            "name": {
              "const": "sdd-unifier"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "calculations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/calculation"
      }
    },
    "architecture": {
      "type": "object",
      "required": [
        "patterns",
        "components",
        "connections"
      ],
      "properties": {
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "status",
              "requirement_ids"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "proposed",
                  "validated",
                  "approved",
                  "blocked"
                ]
              },
              "requirement_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "rationale": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      },
      "additionalProperties": false
    },
    "dr_scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dr"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "diagrams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagram"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "governance": {
      "type": "object",
      "required": [
        "pre_sdd_gate",
        "gate_status",
        "approved_by"
      ],
      "properties": {
        "pre_sdd_gate": {
          "enum": [
            "G0",
            "G1",
            "G2",
            "G3"
          ]
        },
        "gate_status": {
          "enum": [
            "draft",
            "provisional",
            "approved",
            "conditionally_approved",
            "blocked"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "authorized_to_start_sdd": {
          "type": "boolean"
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "export_status",
        "sdd_source_intake",
        "blockers",
        "warnings"
      ],
      "properties": {
        "export_status": {
          "enum": [
            "provisional",
            "approved_technical_handoff",
            "blocked"
          ]
        },
        "sdd_source_intake": {
          "enum": [
            "awaiting_brds",
            "ready_for_reconciliation",
            "blocked"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checked_at": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "type",
        "reference"
      ],
      "properties": {
        "type": {
          "enum": [
            "brd",
            "pre_sdd",
            "business_owner",
            "engineering_measurement",
            "architect_decision",
            "scenario",
            "provider_reference"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string"
        },
        "method": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "domain",
        "description",
        "status",
        "scope",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REQ-[A-Za-z0-9_-]+$"
        },
        "domain": {
          "enum": [
            "business_metric",
            "capacity",
            "performance",
            "availability",
            "recovery",
            "data",
            "security",
            "network",
            "infrastructure",
            "cost",
            "migration",
            "operations",
            "integration"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "measurement_window": {
          "type": "string"
        },
        "failure_scope": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "estimated",
            "open",
            "not_applicable"
          ]
        },
        "owner": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "brd_ref": {
          "type": "string"
        },
        "priority": {
          "enum": [
            "must",
            "should",
            "could"
          ]
        },
        "verification": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "calculation": {
      "type": "object",
      "required": [
        "id",
        "rule_id",
        "formula",
        "input_requirement_ids",
        "output",
        "status",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CALC-[A-Za-z0-9_-]+$"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "formula": {
          "type": "string",
          "minLength": 1
        },
        "substitution": {
          "type": "string"
        },
        "input_requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "output": {
          "type": "object",
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "estimated",
            "open",
            "not_applicable"
          ]
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "status",
        "requirement_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^NODE-[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "actor_boundary",
            "external_dependency",
            "edge",
            "load_balancer",
            "compute",
            "database",
            "cache",
            "messaging",
            "storage",
            "network",
            "identity",
            "security",
            "observability",
            "site",
            "zone",
            "other"
          ]
        },
        "placement": {
          "type": "string"
        },
        "provider_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "provider",
              "service",
              "tradeoffs"
            ],
            "properties": {
              "provider": {
                "enum": [
                  "aws",
                  "azure",
                  "gcp",
                  "on_prem",
                  "generic"
                ]
              },
              "service": {
                "type": "string",
                "minLength": 1
              },
              "tradeoffs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "source_url": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "validated",
            "approved",
            "blocked"
          ]
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "relationship",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EDGE-[A-Za-z0-9_-]+$"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "enum": [
            "request",
            "response",
            "event",
            "replication",
            "network",
            "auth",
            "failover",
            "dependency",
            "other"
          ]
        },
        "direction": {
          "enum": [
            "unidirectional",
            "bidirectional"
          ]
        },
        "protocol": {
          "type": "string"
        },
        "crosses_trust_boundary": {
          "type": "boolean"
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "validated",
            "approved",
            "blocked"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "id",
        "topic",
        "candidate",
        "status",
        "requirement_ids",
        "alternatives",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ADR-CAND-[A-Za-z0-9_-]+$"
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "validated",
            "approved",
            "blocked"
          ]
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "tradeoff"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "tradeoff": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "owner": {
          "type": "string"
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "open_validation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "override": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "by": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dr": {
      "type": "object",
      "required": [
        "id",
        "scope",
        "status",
        "rto_seconds",
        "rpo_seconds",
        "component_ids",
        "validation_tasks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "validated",
            "approved",
            "blocked"
          ]
        },
        "rto_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "rpo_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "strategy_candidate": {
          "type": "string"
        },
        "component_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation_tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "diagram": {
      "type": "object",
      "required": [
        "id",
        "type",
        "status",
        "mermaid_file",
        "summary",
        "component_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "infrastructure",
            "network",
            "dr",
            "deployment",
            "data_flow",
            "context",
            "security",
            "sequence"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "validated",
            "approved",
            "blocked"
          ]
        },
        "mermaid_file": {
          "type": "string",
          "minLength": 1
        },
        "drawio_file": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "component_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "conflict": {
      "type": "object",
      "required": [
        "id",
        "left_source",
        "right_source",
        "description",
        "owner",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "left_source": {
          "type": "string",
          "minLength": 1
        },
        "right_source": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "open",
            "resolved",
            "excepted"
          ]
        },
        "resolution": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
